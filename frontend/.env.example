# =============================================
# Space Stellar Frontend Environment Variables
# =============================================

# Stellar Network Selection ('testnet', 'mainnet', or 'futurenet')
VITE_STELLAR_NETWORK=testnet

# Backend REST & Socket API Base URL
VITE_API_URL=http://localhost:3001

# Space Stellar Game / Token Contract ID
VITE_CONTRACT_ID=CB...your_game_contract_id_here

# PFP NFT Smart Contract ID (Optional, used for special event PFP minting)
# VITE_PFP_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Treasury Wallet Public Key / Account (Optional)
# VITE_TREASURY_ADDRESS=GA...your_treasury_address_here
