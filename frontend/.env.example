# Frontend Environment Variables Template for Space Stellar
# Copy this file to frontend/.env and update values as needed.

# [Required] Target Stellar network: 'testnet' or 'mainnet'
VITE_STELLAR_NETWORK=testnet

# [Required] Space Stellar NFT contract ID
VITE_CONTRACT_ID=CC7MQ3BSNULZ4YX62OMZOZ2RYTZEMUJEWITQJH7YBVXJL75QIZMS2PTX

# [Required] Space Stellar PFP contract ID
VITE_PFP_CONTRACT_ID=CCHNVW6KZGR4MZF5CK5DQLPBNHVSDBGH7ZEC34URZ677JKKEY7GJRIJO

# [Required] Backend API and Socket.io server base URL
VITE_API_URL=http://localhost:3001

# [Required] Treasury Stellar public key / admin address for receiving mint payments
VITE_TREASURY_ADDRESS=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
