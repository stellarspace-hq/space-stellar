# ==============================================================================
# Space Stellar Root & Global Environment Variables Template
# ==============================================================================
# For subsystem specific configurations, also see:
# - Frontend: frontend/.env.example
# - Backend:  backend/.env.example
# ==============================================================================

# Scaffold CLI Environment (`development`, `testing`, `staging`, `production`)
STELLAR_SCAFFOLD_ENV=development

# Location of config files for the Stellar scaffold CLI
XDG_CONFIG_HOME=".config"

# Network configuration for scaffold
PUBLIC_STELLAR_NETWORK="TESTNET"
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# --- Frontend Variables (Vite) ---
# Required:
VITE_STELLAR_NETWORK="testnet"
VITE_API_URL="http://localhost:3001"
VITE_CONTRACT_ID="CB...your_game_contract_id_here"
# Optional:
VITE_PFP_CONTRACT_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"
VITE_TREASURY_ADDRESS="GA...your_treasury_address_here"

# --- Backend Variables (Node / Express) ---
PORT=3001
NODE_ENV=development
STELLAR_NETWORK="testnet"
SOROBAN_RPC_URL="https://soroban-rpc.testnet.stellar.org"
DATABASE_URL="postgresql://user:password@localhost:5432/space_stellar"
FRONTEND_URL="http://localhost:3000"

# Pinata IPFS Credentials
PINATA_JWT="your_pinata_jwt_here"
PINATA_API_KEY="your_pinata_api_key_here"
PINATA_SECRET_KEY="your_pinata_secret_key_here"

# Contract Integration & Secrets
PFP_CONTRACT_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"
PFP_CONTRACT_OWNER_SECRET="SC...your_secret_key_here"
PFP_SERVICE_ACCOUNT_SECRET="SC...your_service_account_secret_here"
# Root & Scaffold Environment Variables Template for Space Stellar
# Copy this file to .env and update values as needed.

# ==============================================================================
# Scaffold & Stellar CLI Configuration
# ==============================================================================

# [Optional] The scaffold environment: development, testing, staging, production (default: development)
STELLAR_SCAFFOLD_ENV=development

# [Optional] Location of CLI configuration files for the scaffold stellar CLI (default: .config)
# More info: https://developers.stellar.org/docs/tools/cli/stellar-cli#stellar-config-dir
XDG_CONFIG_HOME=".config"

# ==============================================================================
# Root Client & Contract Generator Configuration
# ==============================================================================

# [Optional] Stellar network for root scaffold tools: 'testnet' | 'mainnet' (default: testnet)
STELLAR_NETWORK=testnet

# [Optional] Space Stellar NFT contract ID for client generator & scaffold.config.js
CONTRACT_ID=CC7MQ3BSNULZ4YX62OMZOZ2RYTZEMUJEWITQJH7YBVXJL75QIZMS2PTX

# [Optional] Soroban RPC endpoint URL for scaffold.config.js (default: https://soroban-testnet.stellar.org)
RPC_URL=https://soroban-testnet.stellar.org

# ==============================================================================
# Root Scaffold Web App Settings (src/contracts/util.ts)
# ==============================================================================

# [Optional] Network profile for root web scaffold: LOCAL, TESTNET, FUTURENET, PUBLIC (default: LOCAL)
PUBLIC_STELLAR_NETWORK="LOCAL"

# [Optional] Network passphrase corresponding to PUBLIC_STELLAR_NETWORK
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"

# [Optional] Soroban RPC endpoint for root web scaffold (default: http://localhost:8000/rpc)
PUBLIC_STELLAR_RPC_URL="http://localhost:8000/rpc"

# [Optional] Horizon endpoint for root web scaffold (default: http://localhost:8000)
PUBLIC_STELLAR_HORIZON_URL="http://localhost:8000"

