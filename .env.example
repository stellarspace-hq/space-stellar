# Root & Scaffold Environment Variables Template for Space Stellar
# Copy this file to .env and update values as needed.

# ==============================================================================
# Scaffold & Stellar CLI Configuration
# ==============================================================================

# [Optional] The scaffold environment: development, testing, staging, production (default: development)
STELLAR_SCAFFOLD_ENV=development

# [Optional] Location of CLI configuration files for the scaffold stellar CLI (default: .config)
# More info: https://developers.stellar.org/docs/tools/cli/stellar-cli#stellar-config-dir
XDG_CONFIG_HOME=".config"

# ==============================================================================
# Root Client & Contract Generator Configuration
# ==============================================================================

# [Optional] Stellar network for root scaffold tools: 'testnet' | 'mainnet' (default: testnet)
STELLAR_NETWORK=testnet

# [Optional] Space Stellar NFT contract ID for client generator & scaffold.config.js
CONTRACT_ID=CC7MQ3BSNULZ4YX62OMZOZ2RYTZEMUJEWITQJH7YBVXJL75QIZMS2PTX

# [Optional] Soroban RPC endpoint URL for scaffold.config.js (default: https://soroban-testnet.stellar.org)
RPC_URL=https://soroban-testnet.stellar.org

# ==============================================================================
# Root Scaffold Web App Settings (src/contracts/util.ts)
# ==============================================================================

# [Optional] Network profile for root web scaffold: LOCAL, TESTNET, FUTURENET, PUBLIC (default: LOCAL)
PUBLIC_STELLAR_NETWORK="LOCAL"

# [Optional] Network passphrase corresponding to PUBLIC_STELLAR_NETWORK
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"

# [Optional] Soroban RPC endpoint for root web scaffold (default: http://localhost:8000/rpc)
PUBLIC_STELLAR_RPC_URL="http://localhost:8000/rpc"

# [Optional] Horizon endpoint for root web scaffold (default: http://localhost:8000)
PUBLIC_STELLAR_HORIZON_URL="http://localhost:8000"

