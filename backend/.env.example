# Backend Environment Variables Template for Space Stellar
# Copy this file to backend/.env and update values as needed.

# [Optional] Server port (default: 3001)
PORT=3001

# [Optional] Application environment ('development' | 'production', default: development)
NODE_ENV=development

# [Optional] Frontend URL for CORS allowlist (e.g. http://localhost:5173 or production domain)
FRONTEND_URL=http://localhost:5173

# [Optional] Vercel deployment URL for CORS allowlist (without https://)
VERCEL_URL=

# [Optional] Internal/External backend API base URL for self-referential calls (default: http://localhost:3001)
API_URL=http://localhost:3001

# [Required] PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/space_stellar

# [Optional] Database setup script connection settings (used if DATABASE_URL is not set for db:setup)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=space_stellar

# [Optional] Target Stellar network: 'testnet' or 'mainnet' (default: testnet)
STELLAR_NETWORK=testnet

# [Optional] Soroban RPC endpoint URL (defaults to network RPC if unset)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# [Required for PFP Minting] Space Stellar PFP contract ID (C...)
PFP_CONTRACT_ID=CCHNVW6KZGR4MZF5CK5DQLPBNHVSDBGH7ZEC34URZ677JKKEY7GJRIJO

# [Required for PFP Minting] Space Stellar PFP contract owner secret key (S...)
PFP_CONTRACT_OWNER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [Optional for PFP Minting] Service account secret key for fee sponsoring (defaults to owner secret if unset)
PFP_SERVICE_ACCOUNT_SECRET=

# [Optional] Pinata IPFS API Key (for ship/PFP metadata upload)
PINATA_API_KEY=your_pinata_api_key_here

# [Optional] Pinata IPFS Secret API Key
PINATA_SECRET_KEY=your_pinata_secret_key_here

# [Optional] Pinata IPFS JWT Bearer token
PINATA_JWT=your_pinata_jwt_here
