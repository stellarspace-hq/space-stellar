# ============================================
# Space Stellar Backend Environment Variables
# ============================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend & CORS (Optional, defaults to http://localhost:3000 if unset)
FRONTEND_URL=http://localhost:3000

# Stellar Network & Soroban RPC
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-rpc.testnet.stellar.org

# Database Configuration (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/space_stellar

# Database Setup Script Configuration (Optional alternative to DATABASE_URL for setup-database.js)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=space_stellar

# IPFS Pinata Service (Required for PFP and IPFS metadata pinning)
PINATA_JWT=your_pinata_jwt_here
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# PFP NFT Smart Contract
PFP_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
PFP_CONTRACT_OWNER_SECRET=SC...your_secret_key_here
PFP_SERVICE_ACCOUNT_SECRET=SC...your_service_account_secret_here

# Optional / External Integration URLs
# API_URL=http://localhost:3001
